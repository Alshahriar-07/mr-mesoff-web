{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "rewrites": [
    { "source": "/install.ps1", "destination": "/app/install.ps1" },
    { "source": "/install.sh", "destination": "/app/install.sh" }
  ],
  "headers": [
    {
      "source": "/install.ps1",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/install.sh",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ]
}